node_modules/
.env
*.log
.DS_Store
Thumbs.db

# ── Runtime data files (auto-created on first run; never commit) ──────────
# All JSON data files in data/; the .gitkeep placeholder is intentionally kept
# so the empty folder exists on fresh clone.
data/*.json

# ── User-uploaded media (auto-created on first run; never commit) ─────────
# Ignore everything inside uploads/ except the .gitkeep placeholder.
public/uploads/*
!public/uploads/.gitkeep

# scratch
.commitmsg.tmp
