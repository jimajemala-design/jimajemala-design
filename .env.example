# Copy to .env and fill in. .env is gitignored.

GEMINI_API_KEY=your_gemini_key
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000

# ─── Stripe ───────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# From: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Created by: node scripts/setup-stripe-prices.js
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ELITE_ANNUAL=price_xxx

# ─── Email (Gmail) — registration verification codes ──────
# Google Account → Security → enable 2FA → App Passwords → generate for "Mail"
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
